# ============================================================================
# admin/.env.example
# ----------------------------------------------------------------------------
# Environment variables for the Swadyum admin panel (Vite).
# Copy this file to `.env.local` and fill in the values for your environment.
#
# Vite only exposes env vars prefixed with VITE_ to the client bundle, so all
# vars here use that prefix.
# ============================================================================

# Base URL of the Phase 2 Express backend API (see backend/README.md for the
# full route reference). The admin panel talks ONLY to this API — it never
# calls Supabase directly for writes. Local development default is the backend
# dev server on port 4000.
VITE_API_BASE_URL=http://localhost:4000/api

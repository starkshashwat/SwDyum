# ============================================================================
# Swadyum Backend API (Phase 2) — environment variables.
# Copy this file to `.env` (or `.env.local`) inside `backend/` and fill in
# real values. NEVER commit the filled-in file.
# ============================================================================

# ─── Server ─────────────────────────────────────────────────────────────────
# Port the Express API listens on. Defaults to 4000 if unset.
PORT=4000
# Node environment: "production" hides stack traces / raw DB errors in
# responses; "development" includes extra detail for debugging.
NODE_ENV=development

# ─── Supabase (REQUIRED — env.js throws at boot if any are missing) ────────
# Project URL. Same value as root VITE_SUPABASE_URL.
SUPABASE_URL=https://dligrptvajjsbzlcpjsk.supabase.co
# Service-role key. Bypasses RLS. Used ONLY by the supabaseAdmin client, and
# ONLY after requireAdmin middleware has confirmed the caller is a trusted
# admin/editor. NEVER expose this to the frontend or include it in any
# response body.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon key. Honors RLS. Used by the supabaseAnon client for auth verification
# (supabase.auth.getUser) and any public/user-context reads.
SUPABASE_ANON_KEY=your-anon-key

# ─── CORS allow-list ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. NEVER use "*". Example:
#   http://localhost:5173,http://localhost:4173,https://swadyum.store
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Supabase Storage (image uploads) ──────────────────────────────────────
# Bucket used by POST /upload/image. Defaults to "product-images".
STORAGE_BUCKET_PRODUCT_IMAGES=product-images

# ─── Rate limiting (optional overrides; sensible defaults are coded in
#     middleware/rateLimiter.js if these are left unset) ───────────────────
# RATE_LIMIT_WINDOW_MIN=15
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW_MIN=15
# AUTH_RATE_LIMIT_MAX=10

# ─── Velocity Shipping Integration ─────────────────────────────────────────
# Base URL for the Velocity (ShipFast) API.
VELOCITY_BASE_URL=https://shazam.velocity.in
# 32-byte encryption key used to encrypt/decrypt Velocity credentials at rest
# in the shipping_credentials table. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=
# (Optional) Webhook signing secret. Leave blank until Velocity provides one.
# Webhook is not required for core integration — polling is the primary sync.
VELOCITY_WEBHOOK_SECRET=
# Polling interval for the fallback shipment tracking sync job (milliseconds).
# Default: 900000 (15 minutes).
SHIPPING_SYNC_INTERVAL_MS=900000

# ============================================================================
# scripts/data-migration/.env.example
# ----------------------------------------------------------------------------
# Copy this file to `.env` inside `scripts/data-migration/` and fill in real
# values. NEVER commit the filled-in file.
#
# This script talks ONLY to the Phase 2 backend's admin REST API (never
# directly to Supabase), so the only credentials it needs are an admin/editor
# login for that backend.
# ============================================================================

# Base URL of the running backend API (see backend/src/server.js — routes are
# mounted under /api, and the default port is 4000).
BACKEND_BASE_URL=http://localhost:4000/api

# Credentials for a Supabase Auth user whose `profiles.role` is 'Admin' or
# 'Editor' (checked by backend/src/middleware/requireAdmin.js). This is the
# SAME login used for the admin panel — create one via Supabase Auth /
# the admin panel's own signup flow if you don't have one yet.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

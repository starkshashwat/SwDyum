# ─────────────────────────────────────────────────────────────────────────
# Phase 2 backend integration flags (frontend data layer, src/lib/api/)
# ─────────────────────────────────────────────────────────────────────────
#
# These control whether the storefront reads catalog data (products,
# combos, deals, etc.) from the NEW Phase 2 backend (backend/) instead of
# the existing mock/Supabase-direct data sources (src/data/products.js,
# src/mockDb.js, etc.).
#
# DEFAULT / SAFE STATE: leave VITE_USE_NEW_BACKEND unset or "false".
# In that state, the app behaves EXACTLY as it does today — no code path
# introduced by this integration is exercised.
#
# DO NOT set VITE_USE_NEW_BACKEND=true in production until BOTH of the
# following are true:
#   1. The Phase 1 schema migrations (migrations/v2_normalized_schema/)
#      have been applied to the live Supabase project.
#   2. The Phase 2 backend (backend/) has been deployed and is reachable
#      at VITE_BACKEND_BASE_URL.
#
# Even when enabled, every catalogService call that fails for any reason
# (network error, non-2xx response, unexpected shape) automatically falls
# back to the existing mock data — it will never break the page.

# Feature flag: "true" to attempt reading from the new backend, anything
# else (or unset) keeps using existing mock/Supabase data. Default: false.
VITE_USE_NEW_BACKEND=false

# Base URL of the new Phase 2 backend's REST API. Only used when
# VITE_USE_NEW_BACKEND=true. Default matches backend/README.md's default
# PORT=4000 for local development.
VITE_BACKEND_BASE_URL=http://localhost:4000/api
